# 复制为 .env 并填入真实 key(至少填一个)
ZHIPU_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# 每次原子操作等待 monitor 回报的秒数（默认 20）
MONITOR_TIMEOUT_SECONDS=20

# 可选持久化。启用后 SQLite 使用 WAL，服务重启仍可恢复执行与 GraspArm 子步骤。
EXECUTION_DB_PATH=./data/executions.db

# 无账号系统；配置后控制接口和机器人接口分别校验固定 token。
OPERATOR_TOKEN=
GRASPARM_AGENT_TOKEN=
