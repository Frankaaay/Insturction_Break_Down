# 复制为 .env 并填入真实 key(至少填一个)
ZHIPU_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=

# 每次原子操作等待 monitor 回报的秒数（默认 20）
MONITOR_TIMEOUT_SECONDS=20

# 可选持久化。启用后 SQLite 使用 WAL，服务重启仍可恢复执行与 GraspArm 子步骤。
EXECUTION_DB_PATH=./data/executions.db

# 无账号系统；配置后控制接口和机器人接口分别校验固定 token。
OPERATOR_TOKEN=
GRASPARM_AGENT_TOKEN=

# ROS2 Camera Visual Monitor：客户端只持有这个 token，百炼 key 只放服务器。
VISUAL_MONITOR_TOKEN=
VISUAL_MONITOR_MODEL=qwen3.7-plus
VISUAL_MONITOR_STORAGE_ROOT=./monitor/runtime_data
VISUAL_MONITOR_RETENTION_HOURS=24
VISUAL_MONITOR_MAX_CONCURRENCY=2
VISUAL_MONITOR_API_TIMEOUT_SECONDS=30
VISUAL_MONITOR_ATTEMPT_TIMEOUT_SECONDS=120
