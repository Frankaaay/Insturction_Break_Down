[Unit]
Description=Planner Monitor web service on robot ARM
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/workspace/planner_monitor
EnvironmentFile=/root/workspace/planner_monitor/.env
ExecStart=/root/workspace/planner_monitor/.venv/bin/uvicorn server:app --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure
RestartSec=2
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
